<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<header class="site-header">
    <a class="brand" href="${pageContext.request.contextPath}/"><span class="brand-mark">S</span> SCOUT<span>X</span></a>
    <nav class="main-nav">
        <a href="${pageContext.request.contextPath}/">Лента</a>
        <c:if test="${not empty sessionScope.user}">
            <a href="${pageContext.request.contextPath}/places/new">Добавить место</a>
            <a href="${pageContext.request.contextPath}/favorites">Избранное</a>
            <c:if test="${sessionScope.user.admin}"><a href="${pageContext.request.contextPath}/admin">Админка</a></c:if>
        </c:if>
    </nav>
    <div class="header-user">
        <c:choose>
            <c:when test="${not empty sessionScope.user}">
                <span class="user-chip"><c:out value="${sessionScope.user.username}"/></span>
                <form action="${pageContext.request.contextPath}/logout" method="post">
                    <input type="hidden" name="_csrf" value="${requestScope.csrfToken}">
                    <button class="button button-ghost button-small" type="submit">Выйти</button>
                </form>
            </c:when>
            <c:otherwise>
                <a class="button button-ghost button-small" href="${pageContext.request.contextPath}/login">Войти</a>
                <a class="button button-primary button-small" href="${pageContext.request.contextPath}/register">Регистрация</a>
            </c:otherwise>
        </c:choose>
    </div>
</header>
